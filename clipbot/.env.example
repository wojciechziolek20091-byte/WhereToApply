# Copy to .env and fill in. Never commit .env. clipbot never logs these values.
# OpenRouter key. Give it a $0 credit limit so it can only use free models.
OPENROUTER_API_KEY=
YOUTUBE_API_KEY=
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=
# ntfy topic URL (https://ntfy.sh/<topic>) or Telegram bot webhook
NOTIFY_URL=
